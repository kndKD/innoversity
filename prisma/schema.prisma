generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Profiles (Auth & Roles)
model Profile {
  id           String   @id @db.Uuid
  role         String   @default("BUYER") // BUYER | SELLER | MODERATOR | ADMIN | SUPER_ADMIN
  fullName     String?
  district     String?
  phone        String?
  email        String?  @unique
  nicMasked    String?  @map("nic_masked")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet       Wallet?
  products     Product[] @relation("SellerProducts")
  orders       Order[]   @relation("BuyerOrders")

  @@map("profiles")
}

// 2. Wallet (Escrow & Balance)
model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  pendingBalance Decimal  @default(0) @map("pending_balance") @db.Decimal(12, 2) // Escrow Hold
  totalEarned    Decimal  @default(0) @map("total_earned") @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// 3. Products
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  title       String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url")
  status      String   @default("active") // active | pending | rejected
  ratingAvg   Float    @default(0) @map("rating_avg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller      Profile  @relation("SellerProducts", fields: [sellerId], references: [id])
  orders      Order[]

  @@map("products")
}

// 4. Orders (Manual Payment & Escrow)
model Order {
  id              String   @id @default(uuid()) @db.Uuid
  buyerId         String   @map("buyer_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  uniqueAmount    Decimal  @map("unique_amount") @db.Decimal(12, 2) // උදා: 5000.47 (Verify වෙන්න)
  paymentStatus   String   @default("pending") // pending | claimed | verified | completed
  paymentSlipUrl  String?  @map("payment_slip_url")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer           Profile  @relation("BuyerOrders", fields: [buyerId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@map("orders")
}

// 5. OTP Verification (Email OTP flow)
model OtpVerification {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  otpHash   String   @map("otp_hash")
  fullName  String?  @map("full_name")
  password  String
  role      String   @default("BUYER")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

// 6. Admin Audit Log (High-security actions audit trail)
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  adminEmail String   @map("admin_email")
  action     String   // KYC_APPROVE | KYC_REJECT | INNOVATION_APPROVE | INNOVATION_REJECT | ROLE_ASSIGN | ROLE_REVOKE | ADMIN_LOGIN
  targetType String   @map("target_type") // SELLER_KYC | INNOVATION | USER_ROLE | AUTH
  targetId   String?  @map("target_id")
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("admin_audit_logs")
}

// 7. Seller Profiles (KYC Submissions)
model SellerProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  shopName               String?   @map("shop_name")
  shopCategory           String?   @map("shop_category")
  shopBio                String?   @map("shop_bio")
  applicantName          String?   @map("applicant_name")
  institutionOrBusiness  String    @map("institution_or_business")
  district               String
  verificationStatus     String    @default("pending") @map("verification_status") // pending | verifier_approved | admin_approved | approved | rejected
  nicNumber              String    @map("nic_number")
  documentUrl            String    @map("document_url")
  documentType           String?   @default("student_id") @map("document_type")
  submittedAt            DateTime  @default(now()) @map("submitted_at")
  reviewedAt             DateTime? @map("reviewed_at")
  reviewedBy             String?   @map("reviewed_by")
  verifierApprovedAt     DateTime? @map("verifier_approved_at")
  adminApprovedAt        DateTime? @map("admin_approved_at")
  verifierEmail          String?   @map("verifier_email")
  notificationSentAt     DateTime? @map("notification_sent_at")
  notes                  String?

  @@map("seller_profiles")
}
